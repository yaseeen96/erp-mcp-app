ERPNEXT_URL=https://st-erpv15.frappe.cloud

# Public origin of this MCP server. Inspector reads OAuth metadata from here.
# Local: leave unset or http://localhost:3000
# Cloud (already set on the st-attendance server):
# MCP_PUBLIC_URL=https://attendance.mcp.standardtouch.com
# MCP_PUBLIC_URL=http://localhost:3000

# Per-user Frappe OAuth. Users sign in on the ERPNext page with Google or email/password.
ERPNEXT_OAUTH=1

# Desk → OAuth Client "ST Attendance MCP"
# Redirect URIs (all three, exact):
#   http://localhost:3000/mcp/inspector/oauth/callback
#   https://attendance.mcp.standardtouch.com/mcp/inspector/oauth/callback
#   https://inspector.manufact.com/inspector/oauth/callback
# Default Redirect URI can be the production one.
# Scopes must be exactly this, on one line (a space, not two lines):
#   all openid
# FRAPPE_OAUTH_CLIENT_ID=
# FRAPPE_OAUTH_CLIENT_SECRET=
