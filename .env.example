ERPNEXT_URL=https://st-erpv15.frappe.cloud

# Public origin of this MCP server. Inspector reads OAuth metadata from here.
# Local default is http://localhost:3000. Set this when you deploy.
# MCP_PUBLIC_URL=http://localhost:3000

# Per-user Frappe OAuth. Users sign in on the ERPNext page with Google or email/password. Default is on.
# Set to 0 only for local API-key testing.
ERPNEXT_OAUTH=1

# Pre-registered Desk → OAuth Client. Lets Inspector reconnect without DCR on Frappe.
# Redirect URI on that client must be:
#   http://localhost:3000/mcp/inspector/oauth/callback
# Scopes must be exactly this, on one line (a space, not two lines):
#   all openid
# FRAPPE_OAUTH_CLIENT_ID=
# FRAPPE_OAUTH_CLIENT_SECRET=

# Local fallback when ERPNEXT_OAUTH=0. Never commit real secrets.
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
